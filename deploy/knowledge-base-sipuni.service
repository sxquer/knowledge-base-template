[Unit]
Description=Knowledge base Sipuni call import
After=network-online.target knowledge-base-web.service

[Service]
Type=oneshot
User=knowledge-base
Group=knowledge-base
WorkingDirectory=/srv/knowledge-base/current
ExecStart=/usr/bin/php8.4 artisan kb:sync-sipuni --no-interaction
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/knowledge-base/shared /srv/knowledge-base/current/bootstrap/cache
